<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      So the Phase 3 app-rules picker can list the phone's installed
      apps. The list is read on the device, for that screen only: it
      is never transmitted anywhere, and all Sphinx stores is the
      package names the user picked rules for. (Android 11+ hides
      other apps' packages from an app unless it holds this.)
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!--
      For the Phase 4 opt-in "start on boot" setting: lets Android
      tell Sphinx the phone finished booting. Nothing is received
      but that one system broadcast, and the filter restarts only
      if the user opted in AND left the filter on (BootReceiver).
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Lets the Phase 4 battery section offer Android's own per-app
      "stop optimizing battery use?" dialog
      (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS requires the
      caller to hold this). The permission grants nothing by itself:
      the dialog is the system's, the choice is the user's, and
      Sphinx never changes the setting — without this declaration
      the intent always fails and only the settings-list fallback
      would ever run (Phase 4 audit finding).
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_sphinx"
        android:label="@string/app_name"
        android:theme="@style/Theme.Sphinx">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Phase 3 per-app rules picker. Opened only from
             inside Sphinx; not exported. -->
        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="@string/section_apps" />

        <!--
          The filter itself. BIND_VPN_SERVICE means only the Android
          system can bind to it; the VpnService intent-filter is what
          makes Android offer it as a VPN. specialUse foreground type:
          a local DNS filter is not one of Android's built-in FGS
          categories, and the subtype below says exactly what it is.
        -->
        <service
            android:name=".vpn.SphinxVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local DNS ad and tracker filtering" />
        </service>

        <!--
          Phase 4 boot auto-start (opt-in). BOOT_COMPLETED is a
          protected broadcast — only the Android system can send
          it — so exported=true here admits the system, not other
          apps. The receiver itself starts nothing unless the user
          opted in, left the filter on, and VPN consent is in place.
        -->
        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
