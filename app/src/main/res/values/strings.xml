    <string name="app_name">Sphinx</string>
    <string name="tagline">Every request gets questioned.</string>
    <string name="explainer">Sphinx blocks ads and trackers across your whole phone by questioning DNS lookups on the device itself. No remote server, no root. It cannot remove ads served from the same address as the content — YouTube is the honest example.</string>
