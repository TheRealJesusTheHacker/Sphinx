[Unit]
Description=Sphinx — system-wide ad and tracker blocker (DNS filter)
Documentation=file:/usr/share/doc/sphinx/README.md
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/sphinx serve
User=sphinx
Group=sphinx
# Port 53 is privileged; the daemon gets exactly the one capability
# it needs, as an ambient capability so it works with the dedicated
# unprivileged user and NoNewPrivileges — and nothing more.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# The control socket lives here (the sphinx command proves liveness
# and reads counters through it). The daemon writes nothing anywhere
# else: its lists are read-only, its log is memory-only, and the
# resolver record belongs to the command, not the service.
RuntimeDirectory=sphinx
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
